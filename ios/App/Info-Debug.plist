<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug builds only (project.yml): lets the app talk plain http to the dev homeserver on the local network
	     (infra/dev, HALO_DEV_BIND). ATS stays fully on for Beta and Release. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Halo connects to your development homeserver on the local network.</string>
</dict>
</plist>
