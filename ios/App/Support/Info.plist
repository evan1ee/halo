<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Beta and Release (project.yml). Debug uses Info-Debug.plist, which adds local-network access for infra/dev. -->
	<key>HaloNamespace</key>
	<string>$(HALO_NAMESPACE)</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Halo uses your location only when you choose to send it in a chat.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Halo uses the microphone only while you record a voice message to send.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Halo saves photos to your library only when you choose to save them.</string>
	<key>HaloKlipyAPIKey</key>
	<string>$(HALO_KLIPY_API_KEY)</string>
	<key>HaloKeychainAccessGroup</key>
	<string>$(HALO_KEYCHAIN_GROUP)</string>
	<key>HaloPushAppID</key>
	<string>$(HALO_PUSH_APP_ID)</string>
	<key>HaloPushGatewayURL</key>
	<string>$(HALO_PUSH_GATEWAY_URL)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
