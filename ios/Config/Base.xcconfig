// Single definition of the project namespace (D63, docs/development/DEVELOPMENT_SETUP.md §3).
// Every identifier below derives from it; no secrets here.
HALO_NAMESPACE = one.mbm.halo

PRODUCT_BUNDLE_IDENTIFIER = $(HALO_NAMESPACE)
HALO_NSE_BUNDLE_ID = $(HALO_NAMESPACE).nse
HALO_APP_GROUP = group.$(HALO_NAMESPACE)
HALO_KEYCHAIN_GROUP = $(AppIdentifierPrefix)$(HALO_NAMESPACE).shared
HALO_BG_REFRESH_TASK = $(HALO_NAMESPACE).refresh

IPHONEOS_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6
SWIFT_STRICT_CONCURRENCY = complete
TARGETED_DEVICE_FAMILY = 1
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
GENERATE_INFOPLIST_FILE = YES
