# Production / Beta Sygnal configuration using Halo's custom APNs pushkin (ADR-0015 Option 1).
# Copy outside the repository, mount your APNs .p8 key, and fill in key_id / team_id.
log:
  setup:
    version: 1
    formatters:
      normal:
        format: "%(asctime)s [%(levelname)s] %(name)s: %(message)s"
    handlers:
      console:
        class: logging.StreamHandler
        formatter: normal
    root:
      handlers: [console]
      level: INFO
  access:
    x_forwarded_for: false

http:
  bind_addresses: ["0.0.0.0"]
  port: 5000

apps:
  one.mbm.halo:
    type: halo_pushkin.HaloApnsPushkin
    keyfile: /secrets/AuthKey_YOURKEYID.p8
    key_id: YOUR_APNS_KEY_ID
    team_id: YOUR_APPLE_TEAM_ID
    topic: one.mbm.halo
    # Use "sandbox" for Xcode Debug builds, "production" for TestFlight / App Store.
    platform: production
    convert_device_token_to_hex: false
