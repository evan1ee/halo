# Template for ~/.config/halo-dev/contract.env, read by scripts/contract-test.sh (docs/development/AUTONOMOUS_LOOP.md §6).
# Copy it there (chmod 600) and fill in values for throwaway accounts on infra/dev. Never put the filled-in file in the repository.
TEST_RUNNER_HALO_DEV_SERVER=http://localhost:8008
TEST_RUNNER_HALO_DEV_USER=
TEST_RUNNER_HALO_DEV_PASSWORD=
# A room with m.room.image_pack "cats" {wave, dance}, enabled in the user's m.image_pack.rooms (stickers, createPack, mentionsAndEchoes).
TEST_RUNNER_HALO_DEV_STICKER_ROOM=
# A room holding: first, second, a notice, waves, a redacted message, blue.png (Timeline, Media, ReadMarker contracts).
TEST_RUNNER_HALO_DEV_TIMELINE_ROOM=
# A second throwaway account for the Encryption contract.
TEST_RUNNER_HALO_DEV_E2EE_USER=
TEST_RUNNER_HALO_DEV_E2EE_PASSWORD=
# A room without messages on the peer account (HaloUITests.testEmptyRoomStaysResponsive).
TEST_RUNNER_HALO_DEV_EMPTY_ROOM=
